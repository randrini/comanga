# Comanga Configuration
# Copy to .env and fill in values

# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=./data/comanga.db

# ─── Redis (BullMQ job queue) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# ─── Download Sources ────────────────────────────────────────────────────────

# SLSKD (Soulseek client) — primary downloader
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# Prowlarr (indexer manager)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# qBittorrent
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# SABnzbd
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=

# GetComics (scraper, no API key)
GETCOMICS_ENABLED=false

# ComicsCode (scraper, no API key)
COMICSCODE_ENABLED=false

# ─── Metadata Sources ────────────────────────────────────────────────────────
COMICVINE_API_KEY=
MANGADEX_ENABLED=true
ANILIST_ENABLED=true
MANGABAKA_ENABLED=true

# ─── Media ───────────────────────────────────────────────────────────────────
# Where downloaded files are stored
MEDIA_ROOT=./media

# ─── Permissions (for companion services) ─────────────────────────────────────
PUID=1000
PGID=1000